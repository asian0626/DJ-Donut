# ==============================================================================
# Multi-Room Discord Music Bot Cluster - Environment Configuration Template
# ==============================================================================
# ------------------------------------------------------------------------------
# 1. Discord Bot Tokens (Support 1 to 5 Bots Concurrently)
# ------------------------------------------------------------------------------
BOT_TOKEN_1=YOUR_BOT_TOKEN_1
BOT_TOKEN_2=YOUR_BOT_TOKEN_2
BOT_TOKEN_3=YOUR_BOT_TOKEN_3
BOT_TOKEN_4=YOUR_BOT_TOKEN_4
BOT_TOKEN_5=YOUR_BOT_TOKEN_5

# ------------------------------------------------------------------------------
# 2. Lavalink v4 Audio Node (Optional / 選填)
# ------------------------------------------------------------------------------
# Replace CHANGE_ME_STRONG_PASSWORD with a unique secret before exposing Lavalink.
LAVALINK_URI=
LAVALINK_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Set to 1 ONLY if connecting to a self-signed TLS Lavalink node:
LAVALINK_INSECURE_TLS=0

# ------------------------------------------------------------------------------
# 3. External Music APIs (Optional / 選填)
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Last.fm API key for higher-precision autoplay track recommendations:
LASTFM_API_KEY=

# ------------------------------------------------------------------------------
# 4. Runtime, Persistence & Observability Tunables (Optional / 選填)
# ------------------------------------------------------------------------------
DATA_DIR=data
MEDIA_WORKERS=6
MEDIA_TIMEOUT=60
MAX_QUEUE_SIZE=500
COMMAND_COOLDOWN=3
RESTORE_QUEUES=1
QUEUE_SNAPSHOT_INTERVAL=30
METRICS_HOST=127.0.0.1
METRICS_PORT=8080
