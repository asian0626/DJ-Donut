# ==============================================================================
# Multi-Room Discord Music Bot Cluster - Environment Configuration Template
# 多房間音樂機器人矩陣 - 環境變數範本配置
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Discord Bot Tokens / 機器人金鑰 (Support 1 to 5 Bots Concurrently)
# ------------------------------------------------------------------------------
# Put the tokens for 1 to 5 bots. The system dynamically boots as many bots as you configure!
# 填入 1 ~ 5 隻機器人的 Token，系統填入幾隻就自動啟動幾隻！
BOT_TOKEN_1=YOUR_BOT_TOKEN_1
BOT_TOKEN_2=YOUR_BOT_TOKEN_2
BOT_TOKEN_3=YOUR_BOT_TOKEN_3
BOT_TOKEN_4=YOUR_BOT_TOKEN_4
BOT_TOKEN_5=YOUR_BOT_TOKEN_5

# ------------------------------------------------------------------------------
# 2. Lavalink v4 Audio Node / 商業級音訊節點 (Optional / 選填)
# ------------------------------------------------------------------------------
# If configured, unlocks 100% Opus Passthrough (Bit-Perfect), microsecond JDA-NAS clock,
# and real-time 15-band 32-bit float DSP equalizer.
# If left blank or unavailable, automatically falls back to Native 384kbps Studio Engine!
#
# Examples / 常用配置範例:
# 1. Local Node / 本地自建節點 (Docker / Docker Compose):
#    LAVALINK_URI=http://lavalink:2333
#    LAVALINK_PASSWORD=youshallnotpass
# 2. Public SSL Node / 公共高速 SSL 節點:
#    LAVALINK_URI=https://lavalinkv4.serenetia.com:443
#    LAVALINK_PASSWORD=https://seretia.link/discord
# ------------------------------------------------------------------------------
LAVALINK_URI=
LAVALINK_PASSWORD=youshallnotpass

# ------------------------------------------------------------------------------
# 3. Spotify Developer API / 官方 API 認證 (Optional / 選填)
# ------------------------------------------------------------------------------
# The bot features zero-config Spotify parsing out-of-the-box!
# Supplying official API credentials improves loading speed and stability for massive playlists.
# Apply at: https://developer.spotify.com/dashboard
# 內建零設定網頁解析器，免金鑰即可解析 Spotify。填寫可加速 100+ 首超大歌單載入速度。
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
